# ---- Required ----
API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_IDS=              # comma separated user ids, e.g. 12345,67890
DB_URL=                 # MongoDB connection string

# ---- Optional ----
DB_NAME=Encoder_1080p
DB_CHANNEL=             # channel id where finished files are copied (leave empty to disable)
SESSION=
LOG_FILE=bot_logs.txt
SPLIT_SIZE=2000000000

DOWNLOAD_DIR=./downloads_1080p
OUTPUT_DIR=./output_1080p
THUMB_DIR=./thumbs_1080p

# ---- Default encode settings ----
DEFAULT_CODEC=libx265          # libx264 | libx265
DEFAULT_CRF=28
DEFAULT_PRESET=medium
DEFAULT_RESOLUTION=original
DEFAULT_TUNE=none
DEFAULT_AUDIO_CODEC=aac
DEFAULT_AUDIO_BITRATE=64k
DEFAULT_AUDIO_CHANNEL=2            # copy | 1 | 2 | 5.1 | 7.1
DEFAULT_BIT_DEPTH=10
DEFAULT_FPS=copy
DEFAULT_SEND_TYPE=document     # document | media
DEFAULT_RENAME_SOURCE=both     # filename | caption | both
